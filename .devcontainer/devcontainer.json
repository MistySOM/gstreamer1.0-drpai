// For customization options, see https://containers.dev/implementors/json_reference
{
  "name": "gstreamer1.0-drpai",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--name=vscode-gstreamer1.0-drpai"
  ],
  "remoteUser": "ubuntu",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind,readonly",
    "source=/opt/poky,target=/opt/poky,type=bind",
    "source=/tmp,target=/tmp,type=bind"
  ],
  "containerEnv": {
    "POKY_VERSION": "3.1.31",
    "GDB_PORT": "1234"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/opt/poky/${containerEnv:POKY_VERSION}/sysroots/x86_64-pokysdk-linux/usr/bin/aarch64-poky-linux"
  },
  "onCreateCommand": "/workspace/scripts/setup_env.sh",
  "customizations": {
    "jetbrains": {
      "backend": "IntelliJ",
      "settings": {},
      "plugins": [
        "com.github.vitalibo.bitbake-intellij-plugin"
        // Plugin ID can be found on the corresponding plugin’s page at https://plugins.jetbrains.com.
      ]
    },
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "mesonbuild.mesonbuild",
        "cnshenj.vscode-task-manager"
        // Extension ID can be found on the corresponding extension’s page at https://marketplace.visualstudio.com.
      ]
    }
  }
}