{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Meson: Setup x86",
            "command": "rm -rf /workspace/build && /usr/bin/meson setup -Dtvm=disabled -Dmmngr=disabled /workspace/build",
            "problemMatcher": [
                "$meson-gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Meson: Setup Aarch64 Poky",
            "command": "(source /opt/poky/${POKY_VERSION}/environment-setup-aarch64-poky-linux; rm -rf /workspace/build; /usr/bin/meson setup --cross-file meson-aarch64-poky.cross -Dtvm=enabled -Dmmngr=enabled /workspace/build)",
            "problemMatcher": [
                "$meson-gcc"
            ]
        },
        {
            "type": "meson",
            "label": "Meson: Build",
            "mode": "build",
            "problemMatcher": [
                "$meson-gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Remote GDB Server: Start",
            "command": "/workspace/scripts/remote_debug.sh",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "icon": {
                "id": "debug-disconnect",
                "color": "terminal.ansiCyan"
            },
            "group": "build",
            "detail": "Starts the gdbserver and waits for success",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Process*",
                    "endsPattern": "^.*Listening*"
                }
            },
            "dependsOn": [
                "Meson: Build"
            ],
            "dependsOrder": "sequence"
        }
    ]
}