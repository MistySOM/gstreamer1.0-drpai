{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Meson: Setup x86",
            "command": "meson setup --reconfigure -Dtvm=disabled -Dmmngr=disabled --wipe /workspace/build",
            "problemMatcher": [
                "$meson-gcc"
            ]
        },
        {
            "type": "meson",
            "mode": "build",
            "problemMatcher": [
                "$meson-gcc"
            ],
            "group": "build",
            "label": "Meson: Build x86"
        }
    ]
}