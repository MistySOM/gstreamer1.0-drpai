{
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "/bin/bash",
            "args": [],
        },
        "SSH MistySOM": {
            "path": "/workspace/scripts/remote_ssh.sh",
            "icon": "remote",
            "overrideName": true
        },
        "JavaScript Debug Terminal": null,
    },
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.suggest.enabled": true,
    "terminal.integrated.defaultProfile.linux": "bash",
    "editor.formatOnSave": true,
    "C_Cpp.default.compileCommands": "/workspace/build/compile_commands.json",
    "C_Cpp.default.configurationProvider": "mesonbuild.mesonbuild",
    "C_Cpp.codeAnalysis.runAutomatically": true,
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    "C_Cpp.codeAnalysis.clangTidy.codeAction.formatFixes": true,
    "C_Cpp.codeAnalysis.clangTidy.headerFilter": "^/workspace/.*",
    "C_Cpp.codeAnalysis.clangTidy.checks.enabled": [
        "modernize-*",
        "performance-*",
        "bugprone-*",
        "readability-*",
        "clang-analyzer-*",
        "concurrency-*",
        "cppcoreguidelines-*"
    ],
    "C_Cpp.codeAnalysis.clangTidy.checks.disabled": [
        "modernize-use-trailing-return-type",
        "readability-identifier-length",
        "bugprone-easily-swappable-parameters",
        "bugprone-implicit-widening-of-multiplication-result",
        "performance-avoid-endl",
        "cppcoreguidelines-non-private-member-variables-in-classes",
        "cppcoreguidelines-pro-type-reinterpret-cast"
    ],
    "mesonbuild.configureOnOpen": true,
    "mesonbuild.buildFolder": "/workspace/build",
    "mesonbuild.downloadLanguageServer": true,
    "mesonbuild.formatting.enabled": true,
    "mesonbuild.linting.enabled": true,
    "mesonbuild.linter.mesonlsp.enabled": true,
    "mesonbuild.linter.muon.enabled": false,
    "mesonbuild.languageServer": "mesonlsp",
    "mesonbuild.configureOptions": [
        "-Dbuildtype=debug",
        "-Dmmngr=disabled",
        "-Dtvm=disabled"
    ],
    "taskManager.exclude": "rzv_drp-ai_tvm",
    "git.detectSubmodules": false,
    "files.associations": {
        "chrono": "cpp",
        "iostream": "cpp",
        "array": "cpp",
        "atomic": "cpp",
        "bit": "cpp",
        "cctype": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "condition_variable": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "deque": "cpp",
        "map": "cpp",
        "unordered_map": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "functional": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "optional": "cpp",
        "random": "cpp",
        "ratio": "cpp",
        "string": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp",
        "fstream": "cpp",
        "initializer_list": "cpp",
        "iosfwd": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "mutex": "cpp",
        "new": "cpp",
