    "version": "0.2.0",
    "configurations": [
        {
            "name": "Remote Debugging",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/gst-app/gst-launch",
            "cwd": "${workspaceFolder}",
            "args": [],
            "stopAtEntry": false,
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "/opt/poky/3.1.21/sysroots/x86_64-pokysdk-linux/usr/bin/aarch64-poky-linux/aarch64-poky-linux-gdb",
            "miDebuggerServerAddress": "192.168.100.138:1234",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Start GDB Server",
            "postDebugTask": ""
        }
    ]
}