{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Remote Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/gst-app/gst-launch",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "aarch64-poky-linux-gdb",
            "miDebuggerServerAddress": "127.0.0.1:${env:GDB_PORT}",
            "setupCommands": [
                {
                    "text": "python import sys; sys.path.insert(0, '/opt/poky/3.1.31/sysroots/aarch64-poky-linux/usr/share/gcc-9.5.0/python')"
                },
                {
                    "text": "python import sys; sys.path.insert(0, '/opt/poky/3.1.31/sysroots/aarch64-poky-linux/usr/share/gdb/python')"
                },
                {
                    "text": "python from libstdcxx.v6.printers import register_libstdcxx_printers"
                },
                {
                    "text": "python register_libstdcxx_printers(None)"
                },
                {
                    "text": "set sysroot /opt/poky/3.1.31/sysroots/aarch64-poky-linux/"
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Remote: Start GDB Server",
            "postDebugTask": "Remote: Stop Gstreamer"
        }
    ]
}